# =========================================================
# TECH OF THE WORLD — environment configuration
# Copy to .env.local (or set in your hosting dashboard).
# All values are PUBLIC-safe contact settings (no secrets).
# =========================================================

# WhatsApp business number — international format, digits only.
# Example: 9665XXXXXXXX (Saudi) or 201XXXXXXXXX (Egypt)
VITE_WHATSAPP_NUMBER=

# Public business email address shown on the contact page
VITE_CONTACT_EMAIL=

# Optional: backend endpoint that receives the service-request
# form as a JSON POST. When empty, the form switches to
# "draft mode" and offers prefilled WhatsApp / email sending.
VITE_FORM_ENDPOINT=
