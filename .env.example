# =========================================================
# TECH OF THE WORLD — environment configuration
# Copy to .env.local (or set in your hosting dashboard).
# All values are PUBLIC-safe contact settings (no secrets).
# When empty, the verified defaults below are used.
# =========================================================

# WhatsApp — Saudi Arabia (international format, digits only)
VITE_WHATSAPP_SA=+966568992794

# WhatsApp — Egypt
VITE_WHATSAPP_EG=+201203361192

# Public business email address
VITE_CONTACT_EMAIL=TechOfTheWorled92@gmail.com

# Optional: backend endpoint that receives the service-request
# form as a JSON POST. When empty, the form validates, then
# offers the completed request as a prefilled WhatsApp (KSA/EG)
# or email message — integration-ready, no fake backend.
VITE_FORM_ENDPOINT=

# LinkedIn profile shown on the Contact page & footer
VITE_LINKEDIN_URL=https://www.linkedin.com/in/eng-yousef-ahmed/

# ---- Digital business card identity (optional overrides) ----
VITE_CARD_NAME=YOUSEF AHMED MOHMED
VITE_CARD_TITLE=Senior IT Support Specialist
VITE_CARD_EMAIL=youseefa77@gmail.com
VITE_WEBSITE_URL=https://tech-of-the-world.netlify.app

# Contact-page portrait crop anchor (object-position) — tune per photo
# without touching code. Try "50% 8%" (higher) or "50% 25%" (lower).
VITE_CONTACT_PROFILE_POSITION=50% 18%
