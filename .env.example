# =========================================================
# Yousef Ahmed portfolio — environment configuration
# Copy to .env.local (or set in your hosting dashboard).
# All values are PUBLIC-safe contact settings (no secrets).
# When empty, the defaults built into src/config.ts are used.
# =========================================================

# WhatsApp — Saudi Arabia (international format)
VITE_WHATSAPP_SA=+966568992794

# WhatsApp — Egypt
VITE_WHATSAPP_EG=+201203361192

# Public contact email
